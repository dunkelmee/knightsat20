# DATABASE_URL: Postgres connection string for the FastAPI backend.
# Locally this is set by docker-compose.yml automatically. On Railway, attach the
# Postgres plugin and copy its connection string here (Railway calls it DATABASE_URL too).
DATABASE_URL="postgresql://knightsat:knightsat@localhost:5432/knightsat"

# ADMIN_PASSWORD: Shared passcode the organizing committee uses to unlock /admin.
# Change this before deploying — the default below matches the old client-side passcode.
ADMIN_PASSWORD="admin2007"

# SESSION_SECRET: Random secret used to sign the session cookie (user login + admin unlock).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET="change-me-to-a-long-random-value"

# RESEND_API_KEY: API key from https://resend.com used to send login/registration OTP codes.
# If left blank, OTP codes are logged to the server console instead of emailed — fine for local
# dev/testing, but codes will never reach real users' inboxes until this is set.
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: The "From" address OTP emails are sent from. The default
# (onboarding@resend.dev) works out of the box for testing without verifying a domain, but
# real deployments should use a verified sending domain for reliable delivery.
RESEND_FROM_EMAIL="MSHS Batch 2007 <onboarding@resend.dev>"

# PORT: Port the backend listens on. Railway sets this automatically.
PORT="8000"
